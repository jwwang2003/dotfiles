# Read more about SSH config files: https://linux.die.net/man/5/ssh_config
Host wjw_desktop
	HostName      1.tcp.cpolar.cn
	Port          21707
	User          wjw_0

	ServerAliveInterval 30
	ServerAliveCountMax 3

Host wjw_wsl
    User wjw
    HostName 127.0.0.1
    Port 2222                               # ← WSL sshd port
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    ForwardX11 yes
    ForwardX11Trusted yes
    ServerAliveInterval 30
    ServerAliveCountMax 3

    # Hop via Windows, then bridge into WSL’s sshd on 127.0.0.1:2222
    ProxyCommand ssh -T wjw_desktop "cmd.exe /c wsl.exe -d Ubuntu-24.04 bash -lc \"exec nc -q 0 127.0.0.1 2222\""

